{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "causerie",
  "version": "0.1.0",
  "identifier": "com.anabelle.causerie",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Causerie",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "maximizable": true,
        "center": true,
        "label": "main",
        "create": false
      }

    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/goals.json"]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:causerie.db"]
    }
  }
}
